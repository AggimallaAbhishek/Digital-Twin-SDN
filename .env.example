# Copy to .env and fill in real values. NEVER commit .env (see docs/RULEBOOK.md §14).
# This file lists variable NAMES only. Do not put real values here.

# --- LLM providers (fill in the one chosen in ADR-001) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=          # anthropic | openai | google | ollama
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- InfluxDB ---
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=
INFLUXDB_BUCKET=telemetry
INFLUXDB_TOKEN=
INFLUXDB_ADMIN_USER=
INFLUXDB_ADMIN_PASSWORD=

# --- Grafana ---
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# --- MQTT ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Controller / AP agent (on the Ubuntu VM) ---
RYU_REST_URL=http://<vm-ip>:8080
AP_AGENT_URL=http://<vm-ip>:8090

# --- Backend API ---
API_HOST=127.0.0.1
API_PORT=8000
OPERATOR_TOKEN=        # required for /actions/{id}/approve and /apply
