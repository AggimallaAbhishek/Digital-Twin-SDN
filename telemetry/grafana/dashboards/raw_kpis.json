{
 "uid": "raw-kpis",
 "title": "Raw KPIs (P2.2)",
 "description": "Live testbed telemetry from the P2.1 collector: AP load, traffic KPIs and wired links for one run.",
 "tags": [
  "digital-twin-sdn",
  "telemetry"
 ],
 "editable": false,
 "schemaVersion": 39,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "refresh": "5s",
 "liveNow": false,
 "timezone": "browser",
 "templating": {
  "list": [
   {
    "name": "bucket",
    "type": "constant",
    "query": "telemetry",
    "hide": 2
   },
   {
    "name": "run_id",
    "label": "Run",
    "type": "query",
    "datasource": {
     "type": "influxdb",
     "uid": "influxdb"
    },
    "refresh": 2,
    "sort": 0,
    "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"run_id\", predicate: (r) => r._measurement == \"ap_stats\", start: -30d)",
    "current": {},
    "includeAll": false,
    "multi": false
   }
  ]
 },
 "panels": [
  {
   "id": 100,
   "type": "row",
   "title": "Access points",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "id": 1,
   "type": "timeseries",
   "title": "AP downlink throughput (Mbit/s)",
   "description": "Bytes each AP sends over its radio (OpenFlow port 1), from Ryu port stats. Dashed line: measured AP capacity, 4.6 Mbit/s (config/campus_v1.yaml radio_model).",
   "datasource": {
    "type": "influxdb",
    "uid": "influxdb"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "interval": "10s",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb"
     },
     "query": "import \"strings\"\nfrom(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"port_stats\" and r._field == \"tx_bps\")\n  |> filter(fn: (r) => r.run_id == \"${run_id}\")\n  |> filter(fn: (r) => strings.hasPrefix(v: r.dpid, prefix: \"1\") and r.port == \"1\")\n  |> map(fn: (r) => ({r with _value: r._value / 1000000.0}))\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, ap: \"ap\" + strings.substring(v: r.dpid, start: 15, end: 16)}))\n  |> group(columns: [\"ap\"])\n  |> keep(columns: [\"_time\", \"_value\", \"ap\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Mbits",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false,
      "lineInterpolation": "linear",
      "axisSoftMin": 0,
      "gradientMode": "none",
      "thresholdsStyle": {
       "mode": "dashed"
      },
      "axisSoftMax": 5
     },
     "color": {
      "mode": "palette-classic"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "#8e8e8e",
        "value": 4.6
       }
      ]
     },
     "displayName": "${__field.labels.ap}",
     "decimals": 2
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "ap1"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3987e5"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "ap2"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d95926"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "ap3"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#199e70"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "ap4"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#c98500"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   }
  },
  {
